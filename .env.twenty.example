# Twenty CRM secrets — copy this to .env.twenty and fill in all values
# Generate secrets with: openssl rand -base64 32
# Run with: docker compose -f docker-compose.twenty.yml --env-file .env.twenty up -d

# Postgres credentials for Twenty's internal DB
PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=         # generate a strong password

# JWT signing key — required, no default
APP_SECRET=                   # openssl rand -base64 32

# Encryption key for OAuth tokens — required, no default
ENCRYPTION_KEY=               # openssl rand -base64 32

# Public URL (change for Railway/production deployment)
SERVER_URL=http://localhost:3000
